# acme-notes-api — example environment. A FIXTURE: see demo/README.md.
#
# Every value here is a placeholder. Nothing in this file is a real credential, and Brain never
# reads the right-hand side of these lines — it collects secret NAMES and lets Zerops generate
# the values during the import.

# --- Connections. On Zerops these are injected by the platform once the services exist,
#     addressed by hostname on the project's private network. Brain does not declare them as
#     secrets, because doing so would shadow the platform's own values.
DATABASE_URL=postgresql://postgres:localdev@127.0.0.1:5432/notes
REDIS_URL=redis://127.0.0.1:6379
MEILISEARCH_URL=http://127.0.0.1:7700
QDRANT_URL=http://127.0.0.1:6333
NATS_URL=nats://127.0.0.1:4222
S3_ENDPOINT_URL=http://127.0.0.1:9000

# --- Application secrets. These are what Brain declares on the runtime service.
JWT_SECRET=replace-me
SESSION_SECRET=replace-me
MEILI_MASTER_KEY=replace-me
QDRANT_API_KEY=replace-me
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
STRIPE_API_KEY=replace-me
WEBHOOK_SIGNING_SECRET=replace-me
PASSWORD_PEPPER=replace-me

# --- Plain configuration. Not secret, and not a connection.
LOG_LEVEL=info
PORT=3000

# --- A key that is deliberately NOT a secret: it ships to the browser. Brain must leave it
#     alone rather than replacing it with a generated value.
STRIPE_PUBLISHABLE_KEY=pk_test_example
