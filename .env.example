# Local development. On Zerops these come from the platform: services are addressed by
# hostname on the project's private network (db:5432, qdrant:6333, nats:4222) and Zerops
# injects credentials as `servicehostname_ENVKEY` — you do not hand-manage them.
DATABASE_URL=postgresql://postgres:brain@127.0.0.1:55432/brain
QDRANT_URL=http://127.0.0.1:56333
NATS_URL=nats://127.0.0.1:54222
BRAIN_SCOPE=default
